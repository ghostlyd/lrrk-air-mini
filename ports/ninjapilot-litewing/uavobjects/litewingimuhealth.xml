<xml>
    <object name="LiteWingIMUHealth" singleinstance="true" settings="false" category="Sensors">
        <description>Versioned compatible-sensor observations, not aircraft identity. Missing samples and expired healthy observations are unknown.</description>
        <!-- The pinned flight generator parses integer defaults as signed int.
             -1 emits UINT32_MAX on assignment to uint32_t; 4294967295 emits 0. -->
        <field name="SampleAgeMs" units="ms" type="uint32" elements="1" defaultvalue="-1"/>
        <field name="Version" units="" type="uint8" elements="1" defaultvalue="1"/>
        <field name="IdentityVerified" units="" type="enum" elements="1" options="False,True" defaultvalue="False"/>
        <field name="WhoAmI" units="" type="uint8" elements="1" defaultvalue="0"/>
        <field name="SampleSeen" units="" type="enum" elements="1" options="False,True" defaultvalue="False"/>
        <field name="Health" units="" type="enum" elements="1" options="Unknown,Healthy,Unhealthy" defaultvalue="Unknown"/>
        <access gcs="readonly" flight="readwrite"/>
        <telemetrygcs acked="false" updatemode="manual" period="0"/>
        <telemetryflight acked="false" updatemode="manual" period="0"/>
        <logging updatemode="manual" period="0"/>
    </object>
</xml>
