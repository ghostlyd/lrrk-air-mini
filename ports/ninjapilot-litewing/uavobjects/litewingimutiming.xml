<xml>
  <object name="LiteWingIMUTiming" singleinstance="true" settings="false" category="Sensors">
    <description>Diagnostic counters since driver observation reset. Durations include scheduling and bus-lock wait; they do not independently identify electrical faults. Counters saturate.</description>
    <field name="NotificationTimeouts" units="count" type="uint32" elements="1" defaultvalue="0"/>
    <field name="ReadFailures" units="count" type="uint32" elements="1" defaultvalue="0"/>
    <field name="LastWaitUs" units="us" type="uint32" elements="1" defaultvalue="0"/>
    <field name="LastReadUs" units="us" type="uint32" elements="1" defaultvalue="0"/>
    <field name="MaxReadUs" units="us" type="uint32" elements="1" defaultvalue="0"/>
    <field name="Version" units="" type="uint8" elements="1" defaultvalue="1"/>
    <access gcs="readonly" flight="readwrite"/>
    <telemetrygcs acked="false" updatemode="manual" period="0"/>
    <telemetryflight acked="false" updatemode="manual" period="0"/>
    <logging updatemode="manual" period="0"/>
  </object>
</xml>
